# SMART Wi-Fi AutoPay - environment configuration template
# Copy this file to ".env" and adjust values for your machine:
#   cp .env.example .env
# NEVER put real passwords, API keys or tokens in this example file.
# The real ".env" file is ignored by Git.

# Application identity
APP_NAME="SMART Wi-Fi AutoPay"
APP_VERSION=0.1.0

# Environment mode: development | testing | production
APP_ENV=development

# Server binding.
# 127.0.0.1 = reachable only from this machine (safe default).
# A future LAN deployment will use the gateway's LAN address
# (or 0.0.0.0) only after an approved deployment decision.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
